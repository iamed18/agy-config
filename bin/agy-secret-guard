#!/bin/sh
''''exec "${UV_BIN:-$HOME/.local/bin/uv}" run --offline --no-project python "$0" "$@" # '''
# Antigravity + Git secret & PII pre-commit/pre-push leak guard.
# Zero third-party dependencies; runs under uv's managed Python 3.
# Never prints matched secret or denylist values in error output.

from __future__ import annotations

import argparse
import getpass
import json
import os
import re
import shlex
import socket
import subprocess
import sys
from pathlib import Path
from typing import Any

TRIVIAL_ENV_VALUES: frozenset[str] = frozenset(
    {
        "",
        "true",
        "false",
        "0",
        "1",
        "yes",
        "no",
        "iex",
        "sip",
        "data",
        "config",
        "lexicon",
        "finbert",
        "paper",
        "live",
        "localhost",
        "127.0.0.1",
    }
)

GENERIC_USERNAMES: frozenset[str] = frozenset(
    {"root", "user", "admin", "runner", "ubuntu", "ec2-user", "vscode", "app", "test", "ci"}
)

GENERIC_HOSTNAMES: frozenset[str] = frozenset(
    {"localhost", "macbook", "ubuntu", "debian", "alpine", "linux", "runner"}
)

URL_BOILERPLATE_TOKENS: frozenset[str] = frozenset(
    {"https", "http", "discord.com", "discordapp.com", "ptb.discord.com", "canary.discord.com", "api", "webhooks"}
)

TEST_PLACEHOLDER_MARKERS: tuple[str, ...] = (
    "123456789012345678",
    "987654321",
    "123456/",
    "test_token",
    "super_secret",
    "sample_token",
    "example.com",
    "placeholder",
    "dummy",
    "fake",
    "user:pass@",
    "your_token",
    "your_key",
)

FORBIDDEN_FILENAME_PATTERNS: tuple[tuple[str, re.Pattern[str]], ...] = (
    ("dotenv file", re.compile(r"(?:^|/)\.env(?:\.[^/]+)?$")),
    ("private key/cert", re.compile(r"(?:^|/)(?:id_rsa|id_ed25519|id_ecdsa|.*\.(?:pem|key|p12|pfx|jks))$", re.IGNORECASE)),
    ("local database", re.compile(r"\.(?:db|db-wal|db-shm|sqlite|sqlite3)$", re.IGNORECASE)),
    ("rendered LaunchDaemon plist", re.compile(r"(?:^|/)deploy/macos/com\.agytrader\.[^/]+\.plist$")),
)

ALLOWED_DOTENV_BASENAMES: frozenset[str] = frozenset(
    {".env.example", ".env.sample", ".env.template", ".env.dist"}
)

SECRET_REGEXES: tuple[tuple[str, re.Pattern[str]], ...] = (
    (
        "Discord webhook URL",
        re.compile(r"https?://(?:ptb\.|canary\.)?discord(?:app)?\.com/api/webhooks/\d{10,}/[A-Za-z0-9_-]{20,}"),
    ),
    (
        "Slack webhook URL",
        re.compile(r"https?://hooks\.slack\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+"),
    ),
    ("Alpaca API key", re.compile(r"\b(?:PK|AK|CK|SK)[A-Z0-9]{18,}\b")),
    ("AWS access key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("GitHub token", re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z\-_]{35}\b")),
    ("OpenAI/Stripe secret key", re.compile(r"\b(?:sk-(?:proj-|ant-)?|sk_live_|rk_live_)[A-Za-z0-9\-_]{20,}\b")),
    ("PEM private key", re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY-----")),
    ("URL with embedded credentials", re.compile(r"https?://[^/\s:@\"']+:[^/\s@\"']+@[^\s\"']+")),
)

DENYLIST_PATH = Path.home() / ".config" / "agy-secret-guard" / "denylist.txt"


def _run_git(cwd: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        capture_output=True,
        text=True,
        check=False,
    )


def _repo_root(cwd: Path) -> Path | None:
    proc = _run_git(cwd, "rev-parse", "--show-toplevel")
    if proc.returncode != 0 or not proc.stdout.strip():
        return None
    return Path(proc.stdout.strip()).resolve()


def _has_remote(repo_root: Path) -> bool:
    proc = _run_git(repo_root, "remote")
    return proc.returncode == 0 and bool(proc.stdout.strip())


def _git_identity_tokens(repo_root: Path) -> set[str]:
    tokens: set[str] = {repo_root.name}
    for key in ("user.name", "user.email"):
        proc = _run_git(repo_root, "config", key)
        if proc.returncode == 0 and proc.stdout.strip():
            val = proc.stdout.strip()
            tokens.add(val)
            for part in re.split(r"[@\s]+", val):
                if part:
                    tokens.add(part)
    return tokens


def _load_allowlist(repo_root: Path) -> dict[str, Any]:
    path = repo_root / ".secret-guard-allow.json"
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _load_env_matchers(repo_root: Path, git_ident_tokens: set[str]) -> list[tuple[str, str, re.Pattern[str]]]:
    env_path = repo_root / ".env"
    if not env_path.is_file():
        return []
    try:
        raw_lines = env_path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []

    ident_lower = {t.lower() for t in git_ident_tokens if t}
    ident_blob = " ".join(ident_lower)
    matchers: list[tuple[str, str, re.Pattern[str]]] = []
    seen: set[tuple[str, str]] = set()

    for line in raw_lines:
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        k, v = s.split("=", 1)
        key = k.strip()
        val = v.strip()
        if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
            val = val[1:-1].strip()
        if not val or val.lower() in TRIVIAL_ENV_VALUES:
            continue

        search_val = val
        if key == "DISCORD_WEBHOOK_URL":
            m = re.match(r"^https?://[^/]+/api/webhooks/(.+)$", val)
            if m:
                search_val = m.group(1)

        def _add(needle: str, kind: str, *, word_boundary: bool = False) -> None:
            if not needle or needle.lower() in TRIVIAL_ENV_VALUES or needle.lower() in URL_BOILERPLATE_TOKENS:
                return
            if needle.lower() in ident_lower:
                return
            if (key, needle) in seen:
                return
            seen.add((key, needle))
            escaped = re.escape(needle)
            pat_str = rf"\b{escaped}\b" if word_boundary else escaped
            matchers.append((key, kind, re.compile(pat_str)))

        if len(search_val) >= 4:
            _add(search_val, "full_value", word_boundary=False)
        elif len(search_val) >= 2:
            _add(search_val, "full_value", word_boundary=True)

        # Sub-tokens
        for tok in re.split(r"[/,@:;=\s?&()<>]+", search_val):
            tok = tok.strip("\"'")
            if not tok or tok.lower() in TRIVIAL_ENV_VALUES or tok.lower() in URL_BOILERPLATE_TOKENS:
                continue
            if tok.lower() in ident_lower:
                continue
            if len(tok) >= 6:
                _add(tok, "subtoken", word_boundary=False)
            elif len(tok) >= 2 and key in {"BLACKOUT_PERIOD", "LIVE_TRADING_CONFIRMATION"}:
                _add(tok, "subtoken", word_boundary=True)

        # Sliding 8-char windows for high-entropy / credential values
        if len(search_val) >= 16 and key not in {"SEC_EDGAR_USER_AGENT"}:
            step = max(1, len(search_val) // 8)
            for idx in range(0, len(search_val) - 7, step):
                win = search_val[idx : idx + 8]
                if win.lower() not in ident_blob:
                    _add(win, "substring", word_boundary=False)

    return matchers


def _load_host_pii_matchers() -> list[tuple[str, re.Pattern[str]]]:
    matchers: list[tuple[str, re.Pattern[str]]] = []
    user = getpass.getuser().strip()
    home = str(Path.home())
    host = socket.gethostname().split(".")[0].strip()

    if home and len(home) >= 6:
        matchers.append(("local home path", re.compile(re.escape(home))))
    if user and user.lower() not in GENERIC_USERNAMES and len(user) >= 3:
        matchers.append(("local user path", re.compile(rf"/(?:Users|home)/{re.escape(user)}\b")))
        matchers.append(("local tilde user", re.compile(rf"~{re.escape(user)}\b")))
        matchers.append(("OS username", re.compile(rf"(?i)\b{re.escape(user)}\b")))
    if host and host.lower() not in GENERIC_HOSTNAMES and len(host) >= 4:
        matchers.append(("machine hostname", re.compile(rf"(?i)\b{re.escape(host)}\b")))
    return matchers


def _load_denylist_matchers() -> list[tuple[int, re.Pattern[str]]]:
    if not DENYLIST_PATH.is_file():
        return []
    try:
        lines = DENYLIST_PATH.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return []

    out: list[tuple[int, re.Pattern[str]]] = []
    for idx, raw in enumerate(lines, 1):
        s = raw.strip()
        if not s or s.startswith("#"):
            continue
        if s.startswith("re:"):
            try:
                out.append((idx, re.compile(s[3:])))
            except re.error:
                continue
        else:
            escaped = re.escape(s)
            prefix = r"\b" if s[0].isalnum() else ""
            suffix = r"\b" if s[-1].isalnum() else ""
            out.append((idx, re.compile(rf"(?i){prefix}{escaped}{suffix}")))
    return out


def _is_test_placeholder(line: str) -> bool:
    low = line.lower()
    return any(marker in low for marker in TEST_PLACEHOLDER_MARKERS)


def _check_filename(path: str, allowlist: dict[str, Any]) -> str | None:
    ignored = set(allowlist.get("ignore_paths") or ())
    if path in ignored:
        return None
    base = Path(path).name
    if base in ALLOWED_DOTENV_BASENAMES:
        return None
    for label, pat in FORBIDDEN_FILENAME_PATTERNS:
        if pat.search(path):
            return f"[forbidden file] {label}: {path}"
    return None


def _scan_text_lines(
    *,
    source_label: str,
    rel_path: str | None,
    lines: list[tuple[int, str]],
    env_matchers: list[tuple[str, str, re.Pattern[str]]],
    host_matchers: list[tuple[str, re.Pattern[str]]],
    denylist_matchers: list[tuple[int, re.Pattern[str]]],
    allowlist: dict[str, Any],
) -> list[str]:
    findings: list[str] = []
    ignored_paths = set(allowlist.get("ignore_paths") or ()) | {"uv.lock"}
    if rel_path and rel_path in ignored_paths:
        return findings

    ignore_env_by_key: dict[str, set[str]] = {
        k: set(v) for k, v in (allowlist.get("ignore_env_keys_in_paths") or {}).items()
    }
    ignore_deny_paths = set(allowlist.get("ignore_denylist_in_paths") or ())
    # Default safe handling for public constituent ticker catalogs
    is_universe_yaml = rel_path == "config/universe.yaml"

    for lineno, line in lines:
        loc = f"{source_label}:{lineno}" if lineno > 0 else source_label
        is_placeholder = _is_test_placeholder(line)

        for key, kind, pat in env_matchers:
            if rel_path and rel_path in ignore_env_by_key.get(key, set()):
                continue
            if is_universe_yaml and key == "BLACKOUT_PERIOD":
                continue
            if pat.search(line):
                findings.append(f"[.env leak] key={key} ({kind}) matched at {loc}")
                break

        for label, pat in host_matchers:
            if pat.search(line):
                findings.append(f"[host PII] {label} matched at {loc}")

        if not (rel_path and rel_path in ignore_deny_paths) and not is_universe_yaml:
            for idx, pat in denylist_matchers:
                if pat.search(line):
                    findings.append(f"[denylist] private rule #{idx} matched at {loc}")

        if not is_placeholder:
            for label, pat in SECRET_REGEXES:
                if pat.search(line):
                    findings.append(f"[secret pattern] {label} matched at {loc}")

    return findings


def _parse_unified_diff_added_lines(diff_text: str) -> dict[str, list[tuple[int, str]]]:
    added: dict[str, list[tuple[int, str]]] = {}
    cur_file: str | None = None
    cur_line = 0
    hunk_re = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")

    for line in diff_text.splitlines():
        if line.startswith("+++ b/"):
            cur_file = line[6:]
            cur_line = 0
        elif line.startswith("+++ /dev/null"):
            cur_file = None
        elif line.startswith("@@ "):
            m = hunk_re.match(line)
            if m:
                cur_line = int(m.group(1))
        elif cur_file is not None:
            if line.startswith("+") and not line.startswith("+++"):
                added.setdefault(cur_file, []).append((cur_line, line[1:]))
                cur_line += 1
            elif not line.startswith("-") and not line.startswith("\\"):
                cur_line += 1
    return added


def scan_staged(repo_root: Path, *, include_tracked_unstaged: bool = False) -> list[str]:
    if not _has_remote(repo_root):
        return []
    allowlist = _load_allowlist(repo_root)
    env_m = _load_env_matchers(repo_root, _git_identity_tokens(repo_root))
    host_m = _load_host_pii_matchers()
    deny_m = _load_denylist_matchers()

    findings: list[str] = []

    # 1. Staged file paths (added/copied/modified/renamed)
    names_proc = _run_git(repo_root, "diff", "--cached", "--name-only", "--diff-filter=ACMR")
    for p in names_proc.stdout.splitlines():
        p = p.strip()
        if not p:
            continue
        err = _check_filename(p, allowlist)
        if err:
            findings.append(err)

    # 2. Added lines in staged diff
    diff_proc = _run_git(repo_root, "diff", "--cached", "-U0", "--no-color")
    for rel_path, lines in _parse_unified_diff_added_lines(diff_proc.stdout).items():
        findings.extend(
            _scan_text_lines(
                source_label=rel_path,
                rel_path=rel_path,
                lines=lines,
                env_matchers=env_m,
                host_matchers=host_m,
                denylist_matchers=deny_m,
                allowlist=allowlist,
            )
        )

    # 3. For `git commit -a`, also check unstaged modifications to tracked files
    if include_tracked_unstaged:
        unstaged_diff = _run_git(repo_root, "diff", "-U0", "--no-color")
        for rel_path, lines in _parse_unified_diff_added_lines(unstaged_diff.stdout).items():
            err = _check_filename(rel_path, allowlist)
            if err:
                findings.append(err)
            findings.extend(
                _scan_text_lines(
                    source_label=f"{rel_path} (commit -a)",
                    rel_path=rel_path,
                    lines=lines,
                    env_matchers=env_m,
                    host_matchers=host_m,
                    denylist_matchers=deny_m,
                    allowlist=allowlist,
                )
            )

    return findings


def scan_message(repo_root: Path, message_text: str, *, label: str = "commit-message") -> list[str]:
    if not _has_remote(repo_root):
        return []
    allowlist = _load_allowlist(repo_root)
    env_m = _load_env_matchers(repo_root, _git_identity_tokens(repo_root))
    host_m = _load_host_pii_matchers()
    deny_m = _load_denylist_matchers()

    lines = [
        (i, ln)
        for i, ln in enumerate(message_text.splitlines(), 1)
        if not ln.lstrip().startswith("#")
    ]
    return _scan_text_lines(
        source_label=label,
        rel_path=None,
        lines=lines,
        env_matchers=env_m,
        host_matchers=host_m,
        denylist_matchers=deny_m,
        allowlist=allowlist,
    )


def scan_unpushed(repo_root: Path) -> list[str]:
    if not _has_remote(repo_root):
        return []
    allowlist = _load_allowlist(repo_root)
    env_m = _load_env_matchers(repo_root, _git_identity_tokens(repo_root))
    host_m = _load_host_pii_matchers()
    deny_m = _load_denylist_matchers()

    rev_proc = _run_git(repo_root, "rev-list", "HEAD", "--not", "--remotes")
    commits = [c.strip() for c in rev_proc.stdout.splitlines() if c.strip()]
    if not commits:
        return []

    findings: list[str] = []
    for sha in commits[:50]:
        msg_proc = _run_git(repo_root, "show", "-s", "--format=%B", sha)
        findings.extend(
            _scan_text_lines(
                source_label=f"commit {sha[:7]} message",
                rel_path=None,
                lines=list(enumerate(msg_proc.stdout.splitlines(), 1)),
                env_matchers=env_m,
                host_matchers=host_m,
                denylist_matchers=deny_m,
                allowlist=allowlist,
            )
        )
        names_proc = _run_git(
            repo_root, "diff-tree", "--no-commit-id", "--name-only", "-r", "--diff-filter=ACMR", sha
        )
        for p in names_proc.stdout.splitlines():
            p = p.strip()
            if p:
                err = _check_filename(p, allowlist)
                if err:
                    findings.append(f"{err} (in unpushed commit {sha[:7]})")

        diff_proc = _run_git(repo_root, "show", "--format=", "-U0", "--no-color", sha)
        for rel_path, lines in _parse_unified_diff_added_lines(diff_proc.stdout).items():
            findings.extend(
                _scan_text_lines(
                    source_label=f"{rel_path}@{sha[:7]}",
                    rel_path=rel_path,
                    lines=lines,
                    env_matchers=env_m,
                    host_matchers=host_m,
                    denylist_matchers=deny_m,
                    allowlist=allowlist,
                )
            )
    return findings


def _split_shell_segments(cmd: str) -> list[str]:
    return [seg.strip() for seg in re.split(r"(?:&&|\|\||;|\n|\|)", cmd) if seg.strip()]


def _extract_git_invocations(cmd: str, default_cwd: Path) -> list[tuple[Path, str, list[str]]]:
    """Return list of (target_cwd, git_subcommand, remaining_args) for guarded git ops."""
    cur_cwd = default_cwd
    found: list[tuple[Path, str, list[str]]] = []

    for seg in _split_shell_segments(cmd):
        try:
            tokens = shlex.split(seg)
        except ValueError:
            tokens = seg.split()
        if not tokens:
            continue

        # Strip leading VAR=val env assignments
        idx = 0
        while idx < len(tokens) and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tokens[idx]):
            idx += 1
        tokens = tokens[idx:]
        if not tokens:
            continue

        if tokens[0] == "cd" and len(tokens) >= 2:
            target = Path(os.path.expanduser(tokens[1]))
            cur_cwd = target if target.is_absolute() else (cur_cwd / target).resolve()
            continue

        if Path(tokens[0]).name != "git":
            continue

        git_cwd = cur_cwd
        i = 1
        subcmd = ""
        rest: list[str] = []
        while i < len(tokens):
            tok = tokens[i]
            if tok == "-C" and i + 1 < len(tokens):
                target = Path(os.path.expanduser(tokens[i + 1]))
                git_cwd = target if target.is_absolute() else (git_cwd / target).resolve()
                i += 2
                continue
            if tok.startswith("-C") and len(tok) > 2:
                target = Path(os.path.expanduser(tok[2:]))
                git_cwd = target if target.is_absolute() else (git_cwd / target).resolve()
                i += 1
                continue
            if tok in {"-c", "--git-dir", "--work-tree"} and i + 1 < len(tokens):
                i += 2
                continue
            if tok.startswith("-"):
                i += 1
                continue
            subcmd = tok
            rest = tokens[i + 1 :]
            break

        if subcmd in {"commit", "push", "tag", "notes"}:
            found.append((git_cwd, subcmd, rest))

    return found


def _extract_commit_messages_from_args(args: list[str], cwd: Path) -> tuple[list[str], bool]:
    msgs: list[str] = []
    commit_all = False
    i = 0
    while i < len(args):
        tok = args[i]
        if tok in {"-m", "--message"} and i + 1 < len(args):
            msgs.append(args[i + 1])
            i += 2
            continue
        if tok.startswith("--message="):
            msgs.append(tok.split("=", 1)[1])
            i += 1
            continue
        if tok in {"-F", "--file"} and i + 1 < len(args):
            fpath = Path(os.path.expanduser(args[i + 1]))
            if not fpath.is_absolute():
                fpath = cwd / fpath
            if fpath.is_file():
                msgs.append(fpath.read_text(encoding="utf-8", errors="replace"))
            i += 2
            continue
        if tok.startswith("-"):
            if tok == "--all" or (not tok.startswith("--") and "a" in tok[1:]):
                commit_all = True
            if not tok.startswith("--") and "m" in tok[1:] and i + 1 < len(args):
                # Handles combined short flags like -am "msg"
                m_idx = tok.find("m")
                trailing = tok[m_idx + 1 :]
                if trailing:
                    msgs.append(trailing)
                else:
                    msgs.append(args[i + 1])
                    i += 2
                    continue
        i += 1
    return msgs, commit_all


def _format_findings(findings: list[str]) -> str:
    deduped = list(dict.fromkeys(findings))
    shown = deduped[:15]
    more = f"\n... (+{len(deduped) - len(shown)} more)" if len(deduped) > len(shown) else ""
    return (
        "agy-secret-guard blocked this git operation due to potential secret/PII leakage "
        "(values redacted):\n- "
        + "\n- ".join(shown)
        + more
    )


def handle_agy_hook() -> int:
    raw = sys.stdin.read().strip()
    if not raw:
        print(json.dumps({"decision": "allow"}))
        return 0
    try:
        payload = json.loads(raw)
    except ValueError:
        print(json.dumps({"decision": "allow"}))
        return 0

    tool_call = payload.get("toolCall") or {}
    if tool_call.get("name") != "run_command":
        print(json.dumps({"decision": "allow"}))
        return 0

    args = tool_call.get("args") or {}
    cmd = str(args.get("CommandLine") or "")
    if not cmd or "git" not in cmd:
        print(json.dumps({"decision": "allow"}))
        return 0

    cwd_str = payload.get("cwd") or (payload.get("workspacePaths") or [os.getcwd()])[0]
    default_cwd = Path(cwd_str).resolve()
    invocations = _extract_git_invocations(cmd, default_cwd)
    if not invocations:
        print(json.dumps({"decision": "allow"}))
        return 0

    all_findings: list[str] = []
    for target_cwd, subcmd, rest in invocations:
        root = _repo_root(target_cwd)
        if root is None or not _has_remote(root):
            continue
        if subcmd == "commit":
            msgs, commit_all = _extract_commit_messages_from_args(rest, target_cwd)
            all_findings.extend(scan_staged(root, include_tracked_unstaged=commit_all))
            for m in msgs:
                all_findings.extend(scan_message(root, m, label="commit-message"))
        elif subcmd == "push":
            all_findings.extend(scan_unpushed(root))
        elif subcmd in {"tag", "notes"}:
            msgs, _ = _extract_commit_messages_from_args(rest, target_cwd)
            for m in msgs:
                all_findings.extend(scan_message(root, m, label=f"{subcmd}-message"))

    if all_findings:
        print(json.dumps({"decision": "deny", "reason": _format_findings(all_findings)}))
    else:
        print(json.dumps({"decision": "allow"}))
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="agy-secret-guard",
        description="Prevent secret, .env, and host/org PII leaks in remote-attached git repos.",
    )
    parser.add_argument(
        "--mode",
        choices=("agy-hook", "git-pre-commit", "git-commit-msg", "git-pre-push"),
        required=True,
    )
    parser.add_argument("extra", nargs="*")
    ns = parser.parse_args(argv)

    if ns.mode == "agy-hook":
        return handle_agy_hook()

    if os.environ.get("AGY_SECRET_GUARD_BYPASS") == "1":
        return 0

    root = _repo_root(Path.cwd())
    if root is None or not _has_remote(root):
        return 0

    findings: list[str] = []
    if ns.mode == "git-pre-commit":
        findings = scan_staged(root, include_tracked_unstaged=False)
    elif ns.mode == "git-commit-msg":
        if ns.extra:
            msg_path = Path(ns.extra[0])
            if msg_path.is_file():
                findings = scan_message(
                    root,
                    msg_path.read_text(encoding="utf-8", errors="replace"),
                    label="commit-message",
                )
    elif ns.mode == "git-pre-push":
        findings = scan_unpushed(root)

    if findings:
        print(_format_findings(findings), file=sys.stderr)
        print(
            "Override only for verified false positives: AGY_SECRET_GUARD_BYPASS=1 git ...",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
