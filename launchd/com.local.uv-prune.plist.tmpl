<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.uv-prune</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/uv-prune</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/uv-prune.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/uv-prune.err.log</string>
</dict>
</plist>
